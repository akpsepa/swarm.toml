{
  "permissions": {
    "allow": [
      "Agent",
      "Edit",
      "Read",
      "SendMessage",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__swarm__request",
      "mcp__swarm__vote"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "swarm-hook SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "swarm-hook PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "swarm-hook PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "swarm-hook SubagentStart",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "swarm-hook SubagentStop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
